@page "/admin/emails/{id:int}"
@model EmailAnalyzer.Web.Pages.Admin.DetailsModel
@{
    ViewData["Title"] = "Mail Detayı";
    var e = Model.Email;
    var otika = "/otika-bootstrap-admin-template/assets";
    var replySent = e.Reply?.Status == ReplyStatus.Sent;
}

<section class="section">
    <div class="section-header">
        <h1>Mail Detayı</h1>
        <div class="section-header-back">
            <a href="/admin/emails" class="btn btn-icon"><i data-feather="arrow-left"></i> Listeye Dön</a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><h4>@e.Subject</h4></div>
                <div class="card-body">
                    <p class="mb-1"><strong>Gönderen:</strong> @(string.IsNullOrWhiteSpace(e.SenderName) ? "" : e.SenderName + " ") &lt;@e.SenderEmail&gt;</p>
                    <p class="mb-1"><strong>Tarih:</strong> @e.ReceivedDate.ToString("dd.MM.yyyy HH:mm")</p>
                    <p class="mb-3"><strong>Özet:</strong> @e.Summary</p>
                    <hr />
                    <h6>İçerik</h6>
                    <div style="white-space:pre-wrap">@e.Body</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h4>Yanıt</h4>
                    <div class="card-header-action">
                        @if (replySent)
                        {
                            <span class="badge badge-success">Gönderildi</span>
                        }
                        else
                        {
                            <span id="replyBadge" class="badge badge-secondary" style="@(e.Reply is null ? "display:none" : "")">Taslak</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (replySent)
                    {
                        <div class="alert alert-success">
                            Yanıt @(e.Reply!.SentDate?.ToString("dd.MM.yyyy HH:mm")) tarihinde
                            <strong>@e.SenderEmail</strong> adresine gönderildi.
                        </div>
                        <div style="white-space:pre-wrap">@e.Reply.Body</div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(e.Reply?.LastSendError))
                        {
                            <div class="alert alert-danger alert-dismissible show fade">
                                <div class="alert-body">
                                    <button class="close" data-dismiss="alert"><span>&times;</span></button>
                                    Son gönderim hatası: @e.Reply.LastSendError
                                </div>
                            </div>
                        }
                        <div class="form-group mb-2">
                            <textarea id="replyBody" class="form-control" rows="18"
                                      style="min-height:420px;resize:vertical;font-size:0.95rem;line-height:1.6;"
                                      placeholder="AI taslağı için &quot;Yanıt Oluştur&quot;a basın veya yanıtınızı yazın...">@(e.Reply?.Body)</textarea>
                        </div>
                        <div class="d-flex align-items-center flex-wrap">
                            <button type="button" id="btnGenerate" class="btn btn-primary mr-2 mb-2">
                                <i data-feather="zap"></i> Yanıt Oluştur
                            </button>
                            <button type="button" id="btnSaveDraft" class="btn btn-info mr-2 mb-2">
                                <i data-feather="save"></i> Taslağı Kaydet
                            </button>
                            <button type="button" id="btnSend" class="btn btn-success mr-2 mb-2">
                                <i data-feather="send"></i> Gönder
                            </button>
                            <small id="replyStatusLine" class="text-muted mb-2">
                                @if (e.Reply?.UpdatedDate is not null)
                                {
                                    @:Son kayıt: @e.Reply.UpdatedDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                }
                            </small>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h4>AI Ham Yanıtı</h4></div>
                <div class="card-body">
                    <pre style="white-space:pre-wrap;font-size:0.85rem">@e.AiRawResponse</pre>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><h4>Analiz</h4></div>
                <div class="card-body">
                    <p><strong>Kategori:</strong> @e.MainCategoryDisplay</p>
                    <p><strong>Alt Konu:</strong> @e.SubCategory</p>
                    <p><strong>Öncelik:</strong> <span class="badge @DisplayNames.BadgeClass(e.Priority)">@e.PriorityDisplay</span></p>
                    <p><strong>Duygu:</strong> @e.SentimentDisplay</p>
                    <p><strong>Güven Skoru:</strong> @e.AiConfidenceScore.ToString("0.00")</p>
                    <p>
                        <strong>Durum:</strong>
                        @if (e.RequiresHumanReview)
                        {
                            <span class="badge badge-warning">İnceleme Bekliyor</span>
                        }
                        else
                        {
                            <span class="badge badge-success">İncelendi</span>
                        }
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h4>Düzelt & İncele</h4></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Review" asp-route-id="@e.Id">
                        <div class="form-group">
                            <label>Kategori</label>
                            <select name="ReviewMainCategory" class="form-control">
                                @foreach (var c in Enum.GetValues<MainCategory>())
                                {
                                    <option value="@c" selected="@(Model.ReviewMainCategory == c)">@DisplayNames.For(c)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Alt Konu</label>
                            <input type="text" name="ReviewSubCategory" value="@Model.ReviewSubCategory" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label>Öncelik</label>
                            <select name="ReviewPriority" class="form-control">
                                @foreach (var p in Enum.GetValues<Priority>())
                                {
                                    <option value="@p" selected="@(Model.ReviewPriority == p)">@DisplayNames.For(p)</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">İncelendi Olarak Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
@if (!replySent)
{
<link rel="stylesheet" href="@otika/bundles/izitoast/css/iziToast.min.css">
<script src="@otika/bundles/izitoast/js/iziToast.min.js"></script>
<script src="@otika/bundles/sweetalert/sweetalert.min.js"></script>
<script>
    (function () {
        const emailId = @e.Id;
        const textarea = document.getElementById('replyBody');
        const btnGenerate = document.getElementById('btnGenerate');
        const btnSaveDraft = document.getElementById('btnSaveDraft');
        const btnSend = document.getElementById('btnSend');
        const badge = document.getElementById('replyBadge');
        const statusLine = document.getElementById('replyStatusLine');

        // The exact text of the last AI generation; while the textarea still matches it,
        // the draft is saved with isAiGenerated=true.
        let lastGenerated = @Json.Serialize(e.Reply?.IsAiGenerated == true ? e.Reply.Body : null);
        let lastRawResponse = null;

        function toast(type, message) {
            iziToast[type]({ title: type === 'error' ? 'Hata' : 'Bilgi', message: message, position: 'topRight' });
        }

        function setBusy(activeBtn, busy) {
            [btnGenerate, btnSaveDraft, btnSend].forEach(b => b.disabled = busy);
            activeBtn.classList.toggle('btn-progress', busy);
        }

        function draftPayload() {
            const body = textarea.value;
            const isAi = lastGenerated !== null && body === lastGenerated;
            return { replyBody: body, isAiGenerated: isAi, aiRawResponse: isAi ? lastRawResponse : null };
        }

        function markSaved() {
            badge.style.display = '';
            statusLine.textContent = 'Son kayıt: ' + new Date().toLocaleString('tr-TR', {
                day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
            });
        }

        async function readError(res) {
            const data = await res.json().catch(() => ({}));
            return data.error || 'İşlem başarısız oldu. Lütfen tekrar deneyin.';
        }

        btnGenerate.addEventListener('click', async function () {
            if (textarea.value.trim()) {
                const overwrite = await swal({
                    title: 'Üzerine yazılsın mı?',
                    text: 'Mevcut yanıt metni, yeni oluşturulacak AI taslağıyla değiştirilecek.',
                    icon: 'warning',
                    buttons: ['Vazgeç', 'Üzerine Yaz'],
                    dangerMode: true
                });
                if (!overwrite) return;
            }

            setBusy(btnGenerate, true);
            try {
                const res = await fetch(`/api/emails/${emailId}/reply/generate`, { method: 'POST' });
                if (!res.ok) { toast('error', await readError(res)); return; }
                const data = await res.json();
                textarea.value = data.replyBody;
                lastGenerated = data.replyBody;
                lastRawResponse = data.rawResponse || null;
                toast('success', 'Yanıt taslağı oluşturuldu. Göndermeden önce kontrol edin.');
            } catch {
                toast('error', 'Sunucuya ulaşılamadı.');
            } finally {
                setBusy(btnGenerate, false);
            }
        });

        btnSaveDraft.addEventListener('click', async function () {
            if (!textarea.value.trim()) { toast('error', 'Yanıt metni boş olamaz.'); return; }

            setBusy(btnSaveDraft, true);
            try {
                const res = await fetch(`/api/emails/${emailId}/reply`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(draftPayload())
                });
                if (!res.ok) { toast('error', await readError(res)); return; }
                markSaved();
                toast('success', 'Taslak kaydedildi.');
            } catch {
                toast('error', 'Sunucuya ulaşılamadı.');
            } finally {
                setBusy(btnSaveDraft, false);
            }
        });

        btnSend.addEventListener('click', async function () {
            if (!textarea.value.trim()) { toast('error', 'Yanıt metni boş olamaz.'); return; }

            const confirmed = await swal({
                title: 'Yanıt gönderilsin mi?',
                text: '@e.SenderEmail adresine gönderilecek.',
                icon: 'warning',
                buttons: ['Vazgeç', 'Gönder']
            });
            if (!confirmed) return;

            setBusy(btnSend, true);
            try {
                const res = await fetch(`/api/emails/${emailId}/reply/send`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(draftPayload())
                });
                if (!res.ok) { toast('error', await readError(res)); setBusy(btnSend, false); return; }
                toast('success', 'Yanıt gönderildi.');
                // Reload so the server renders the sent-state panel.
                setTimeout(() => location.reload(), 800);
            } catch {
                toast('error', 'Sunucuya ulaşılamadı.');
                setBusy(btnSend, false);
            }
        });
    })();
</script>
}
}
