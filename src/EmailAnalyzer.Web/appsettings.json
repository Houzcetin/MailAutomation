        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=EmailAnalyzerDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
